# Copy to .env locally. This example contains NO real credentials.
# Generate a random API key (see README); the placeholder is intentionally rejected.
API_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
BIND_ADDR=127.0.0.1:8080
DATA_DIR=data

# Gmail example. For a domain mailbox, use your email provider's SMTP settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=your-account@example.com
SMTP_PASSWORD=REPLACE_WITH_PROVIDER_APP_PASSWORD
SMTP_FROM=your-account@example.com

# Alternative: SMTP_TLS=implicit and SMTP_PORT=465.
SMTP_TIMEOUT_SECONDS=30
WORKER_CONCURRENCY=2
MAX_PENDING_JOBS=1000
REQUESTS_PER_MINUTE=120
JOB_RETENTION_HOURS=24

# Optional exact domain allowlist, comma-separated. Blank allows all recipient domains.
# Example: example.com,example.org (does not include their subdomains)
ALLOWED_RECIPIENT_DOMAINS=
