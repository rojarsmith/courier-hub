# Public template only. Install outside Git as /etc/courier-hub/service.env.
# systemd EnvironmentFile syntax: KEY=value; no export or shell expansion.
# Quote values with spaces or special characters. Use a real random API key.
API_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
BIND_ADDR=127.0.0.1:8080
DATA_DIR=/var/lib/courier-hub
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=your-account@example.com
SMTP_PASSWORD=REPLACE_WITH_PROVIDER_APP_PASSWORD
SMTP_FROM=your-account@example.com
SMTP_TIMEOUT_SECONDS=30
WORKER_CONCURRENCY=2
MAX_PENDING_JOBS=1000
REQUESTS_PER_MINUTE=120
JOB_RETENTION_HOURS=24
ALLOWED_RECIPIENT_DOMAINS=
