[Unit]
Description=Courier Hub asynchronous SMTP relay API
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=courier-hub
Group=courier-hub
WorkingDirectory=/opt/courier-hub
ExecStart=/opt/courier-hub/courier-hub
EnvironmentFile=/etc/courier-hub/service.env
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=150
UMask=0077
StateDirectory=courier-hub
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/courier-hub
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
LockPersonality=true

[Install]
WantedBy=multi-user.target
